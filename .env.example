# Origen del backend, sin "/api" al final (el código agrega /api/... y /storage/...).
# Debe ser accesible desde el navegador del visitante, no solo desde el contenedor.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Puerto del host donde se publica la web
WEB_PORT=3000

# --- Libro de Reclamaciones (backend de OVERSITE) ---
# Lo usa solo el servidor de Next. En Docker, el backend por la red oversite_app (valor por defecto).
# En desarrollo: http://localhost:3000/api (y correr esta web en otro puerto: npm run dev -- -p 3002).
OVERSITE_API_URL=http://backend:3000/api

# Clave del SITIO de Cloudflare Turnstile (la secreta va en el backend, TURNSTILE_SECRET_KEY).
# Desarrollo: clave de prueba publicada por Cloudflare que siempre aprueba: 1x00000000000000000000AA
TURNSTILE_SITE_KEY=
